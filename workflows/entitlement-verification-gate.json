    {
      "id": "7e7c4c5d-cf2b-5a65-af5b-e28a27c3d3c7",
      "name": "Verify entitlement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Entitlement gate · decide. Zero trust: only a purchase row in good standing for this exact email (and sku) passes.\nconst r = $('Normalize request').first().json;\nconst GOOD = ['paid', 'active', 'completed', 'fulfilled'];\nlet rows = [];\ntry { rows = $('Find purchases').all().map(i => i.json).filter(x => x && x.email); } catch (e) { rows = []; }\nconst mine = rows.filter(x => String(x.email).toLowerCase() === r.email);\nconst good = mine.filter(x => GOOD.includes(String(x.status || '').toLowerCase()));\nconst match = good.filter(x => !r.sku || String(x.sku || '').toLowerCase() === r.sku);\n\nlet reason = '';\nif (!r.valid_email) reason = 'invalid_email';\nelse if (!mine.length) reason = 'no_purchase_for_email';\nelse if (!good.length) reason = 'purchase_not_in_good_standing'; // refunded, disputed, cancelled, pending\nelse if (!match.length) reason = 'sku_not_purchased';\n\nconst verified = !reason;\nconst order = verified\n  ? match.slice().sort((a, b) => String(b.purchased_at || '').localeCompare(String(a.purchased_at || '')))[0]\n  : null;\n\nreturn [{ json: Object.assign({}, r, {\n  verified,\n  decision: verified ? 'deliver' : 'held',\n  reason: verified ? 'verified_purchase' : reason,\n  order_id: order ? String(order.order_id || '') : '',\n  // Ship to the address on the order, never to whatever was typed into a form.\n  deliver_to: order ? String(order.email) : '',\n  skus: verified ? [...new Set(match.map(x => String(x.sku || '')).filter(Boolean))] : []\n}) }];\n"
      }
    },
