    {
      "id": "92b1eeb3-031d-5f46-922d-1e52824a3593",
      "name": "Normalize request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Entitlement gate · normalize the request.\n// Accepts application/json or text/plain JSON. Only email, sku and request_id are read from the caller.\nconst crypto = require('crypto');\n\n// ---- Options ---------------------------------------------------------------\n// Fold Gmail aliases so jane.doe+promo@gmail.com and janedoe@gmail.com are one buyer.\n// Use the SAME setting in the purchase recorder, or lookups will miss.\nconst FOLD_GMAIL_ALIASES = true;\nconst GMAIL_DOMAINS = ['gmail.com', 'googlemail.com'];\n// ---------------------------------------------------------------------------\n\nconst hook = $('Request in').first().json || {};\nlet b = hook.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nif (!b || typeof b !== 'object' || Array.isArray(b)) b = {};\n// text/plain bodies can arrive as { \"<json string>\": \"\" }\nconst keys = Object.keys(b);\nif (!b.email && keys.length === 1 && keys[0].trim().startsWith('{')) { try { b = JSON.parse(keys[0]); } catch (e) {} }\nconst hdr = hook.headers || {};\nconst s = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\nfunction canonicalEmail(email) {\n  const at = email.lastIndexOf('@');\n  if (at < 1) return email;\n  let local = email.slice(0, at);\n  let domain = email.slice(at + 1);\n  if (domain === 'googlemail.com') domain = 'gmail.com';\n  if (FOLD_GMAIL_ALIASES && GMAIL_DOMAINS.includes(domain)) local = local.split('+')[0].replace(/\\./g, '');\n  return local + '@' + domain;\n}\n\nconst typed = s(b.email).toLowerCase().slice(0, 254);\nconst valid = /^[^\\s@,;<>\"]+@[^\\s@,;<>\"]+\\.[^\\s@,;<>\"]+$/.test(typed);\nconst email = valid ? canonicalEmail(typed) : '';\nconst sku = s(b.sku || b.product).toLowerCase().replace(/[^a-z0-9_\\-]/g, '').slice(0, 64);\n\n// Idempotency: prefer the caller's Idempotency-Key header or body.request_id.\n// Otherwise derive one from email + sku, so double clicks and retries collapse into one request.\nlet requestId = s(hdr['idempotency-key'] || b.request_id).replace(/[^A-Za-z0-9_\\-:.]/g, '').slice(0, 128);\nif (!requestId) requestId = 'drv_' + crypto.createHash('sha256').update(email + '|' + sku).digest('hex').slice(0, 32);\n\nreturn [{ json: {\n  request_id: requestId,\n  email,\n  email_as_typed: typed,\n  valid_email: valid,\n  sku,\n  user_agent: s(hdr['user-agent']).slice(0, 300),\n  received_at: new Date().toISOString()\n} }];\n"
      }
